#!/usr/bin/env bash
# Use the local ForumKit checkouts (../forumkit-*) instead of the GitHub versions, so a
# change in a package shows up here at once. Run inside the project; needs DDEV.
#
# This edits composer.json and composer.lock. Do not commit those changes: run
# bin/dev-unlink first.
set -euo pipefail
cd "$(dirname "$0")/.."

packages=(core entitlements)

for name in "${packages[@]}"; do
  if [ ! -d "../forumkit-${name}" ]; then
    echo "Missing ../forumkit-${name}: clone it next to this project first." >&2
    exit 1
  fi
done

# Local path repositories come first, so Composer prefers them over Packagist.
python3 - <<'PY'
import json

with open("composer.json") as handle:
    data = json.load(handle)

# A symlinked checkout reports itself as dev-master, which would not satisfy the packages'
# own ^0.1 constraints on each other, so say which release line the checkouts stand for.
# Bump this when the packages move to a new 0.x minor.
line = "0.1.x-dev"
local = [
    {
        "type": "path",
        "url": f"/var/www/forumkit-{name}",
        "options": {"symlink": True, "versions": {f"zcwilt/forumkit-{name}": line}},
    }
    for name in ("core", "entitlements")
]
rest = [repo for repo in data.get("repositories", []) if repo.get("type") != "path"]
data["repositories"] = local + rest

with open("composer.json", "w") as handle:
    json.dump(data, handle, indent=4, ensure_ascii=False)
    handle.write("\n")
PY

ddev restart >/dev/null
ddev composer require --no-interaction \
  zcwilt/forumkit-core:@dev \
  zcwilt/forumkit-entitlements:@dev

echo
echo "Linked. vendor/zcwilt/ now points at your checkouts:"
ls -l vendor/zcwilt
