#!/usr/bin/env bash
# Undo bin/dev-link: go back to the committed composer.json and composer.lock and the
# Packagist versions of the ForumKit packages.
set -euo pipefail
cd "$(dirname "$0")/.."

git checkout -- composer.json composer.lock
ddev composer install --no-interaction

echo
echo "Unlinked. vendor/zencart/ is back to the installed Packagist versions."
